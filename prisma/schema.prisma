generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// AUTHENTICATION (NextAuth / Auth.js)
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  player        Player?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

// ------------------------------------------------------
// EVENT LOG (The Single Source of Truth)
// ------------------------------------------------------
model EventLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  playerId  String
  eventType String
  payload   Json

  @@index([playerId])
  @@index([timestamp])
}

// ------------------------------------------------------
// READ PROJECTIONS
// ------------------------------------------------------

model Player {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  level       Int      @default(1)
  xp          Int      @default(0)
  health      Int      @default(100)
  energy      Int      @default(100)
  hunger      Int      @default(0)
  sanity      Int      @default(100)
  fatigue     Int      @default(0)
  thirst      Int      @default(0)
  isAlive     Boolean  @default(true)
  distanceTraveled Int @default(0)
  credits     Int      @default(0)
  upgradeCharges Int   @default(6)
  lastUpgradeReset DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Rebuild: progression + world clock ---
  maxHealth   Int      @default(100)
  turns       Int      @default(0)   // in-world clock ticks; 1 turn = 30 in-world minutes
  chapter     Int      @default(1)   // story act the player has reached
  reputation  Int      @default(0)   // standing with the Convoy / roadside factions
  skillPoints Int      @default(0)   // unspent points granted on level-up
  storyFlags  Json     @default("{}")

  vehicle         Vehicle?
  inventory       PlayerInventory[]
  activeEncounter ActiveEncounter?
  quests          ActiveQuest[]
  npcRelations    NpcRelation[]
}

// Per-player standing with a named NPC. Affinity drives what an NPC will
// offer (discounts, gifts, side quests) when you meet them on the road.
model NpcRelation {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  npcId     String
  affinity  Int      @default(0)
  metCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, npcId])
  @@index([playerId])
}

enum RarityTier {
  COMMON
  UNCOMMON
  SILVER
  GOLD
  ORANGE
  PURPLE
  BLACK
  RED
  MYTHICAL
}

model Vehicle {
  id          String   @id @default(uuid())
  playerId    String   @unique
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type        String   @default("Common Van")
  level       Int      @default(1)
  armor       Int      @default(10)
  fuel        Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  components  VehicleComponent[]
}

enum ComponentType {
  ENGINE
  CHASSIS
  TIRES
  ARMOR
  STORAGE
  FUEL_SYSTEM
}

model VehicleComponent {
  id             String        @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type           ComponentType
  name           String
  rarity         RarityTier    @default(COMMON)
  isUpgraded     Boolean       @default(false) // legacy; superseded by upgradeCount
  upgradeCount   Int           @default(0)
  durability     Float         @default(100.0)
  maxDurability  Float         @default(100.0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([vehicleId])
}

model PlayerInventory {
  instanceId      String      @id @default(uuid())
  playerId        String
  player          Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  baseItemId      String
  rarity          RarityTier  @default(COMMON)
  quantity        Int         @default(1)
  currentDurability Float     @default(100.0)
  isUpgraded      Boolean     @default(false) // legacy; superseded by upgradeCount
  upgradeCount    Int         @default(0)
  equipSlot       String?     // "WEAPON", "HEAD", "CHEST", "LEGS", or null

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([playerId, equipSlot])
}

model ActiveEncounter {
  id              String    @id @default(uuid())
  playerId        String    @unique
  player          Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  enemyName       String
  enemyHp         Float
  enemyMaxHp      Float
  enemyAttack     Float
  statusEffects   Json      @default("{}")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WorldObject {
  id          String   @id @default(uuid())
  type        String   // e.g., "Loot", "NPC", "Monster"
  sectorId    String
  positionX   Float
  positionY   Float
  metadata    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  @@index([sectorId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  channel   String   @default("WORLD") // WORLD, SYSTEM, TRADE
  sender    String
  message   String
  npcId     String?  // set when the speaker is a world NPC rather than a player
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ActiveQuest {
  id          String   @id @default(uuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questId     String
  progress    Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([playerId, questId])
}
