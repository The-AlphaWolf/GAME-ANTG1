generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// AUTHENTICATION (NextAuth / Auth.js)
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  player        Player?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

// ------------------------------------------------------
// EVENT LOG (The Single Source of Truth)
// ------------------------------------------------------
model EventLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  playerId  String
  eventType String
  payload   Json

  @@index([playerId])
  @@index([timestamp])
}

// ------------------------------------------------------
// READ PROJECTIONS
// ------------------------------------------------------

model Player {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  level       Int      @default(1)
  xp          Int      @default(0)
  health      Int      @default(100)
  energy      Int      @default(100)
  hunger      Int      @default(0)
  sanity      Int      @default(100)
  fatigue     Int      @default(0)
  thirst      Int      @default(0)
  isAlive     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  vehicle     Vehicle?
  inventory   PlayerInventory[]
}

model Vehicle {
  id          String   @id @default(uuid())
  playerId    String   @unique
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type        String   @default("Common Van")
  level       Int      @default(1)
  armor       Int      @default(10)
  fuel        Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlayerInventory {
  instanceId      String    @id @default(uuid())
  playerId        String
  player          Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  baseItemId      String
  rarity          Int       @default(1)
  quantity        Int       @default(1)
  currentDurability Float   @default(100.0)
  hasBeenUpgraded Boolean   @default(false)
  equipSlot       String?   // "WEAPON", "HEAD", "CHEST", "LEGS", or null

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([playerId, equipSlot])
}

model WorldObject {
  id          String   @id @default(uuid())
  type        String   // e.g., "Loot", "NPC", "Monster"
  sectorId    String
  positionX   Float
  positionY   Float
  metadata    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  @@index([sectorId])
}
